# =============================================================================
# Ortam değişkenleri — bu dosyayı .env.local olarak kopyalayıp doldurun.
#
#   cp .env.example .env.local
#
# .env.local gitignore kapsamındadır, asla commit edilmez.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase
#
# Nereden alınır: Supabase panelinde projeniz > Settings > API
# -----------------------------------------------------------------------------

# Project URL  (Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# anon / public key  (Settings > API > Project API keys > anon public)
# Tarayıcıya gönderilir; güvenlidir çünkü tüm erişim RLS ile sınırlıdır.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key  (Settings > API > Project API keys > service_role)
#
# !! DİKKAT: Bu anahtar RLS'i tamamen atlar ve tüm veriye sınırsız erişim verir.
# !! Asla NEXT_PUBLIC_ öneki verilmemeli, asla istemci koduna sızmamalı.
# !! Yalnızca sunucu tarafında (moderasyon, webhook, ödeme onayı) kullanılır.
SUPABASE_SERVICE_ROLE_KEY=

# Veritabanı bağlantı dizesi — yalnızca göç/seed çalıştırmak için gerekir.
#
# Nereden alınır: Settings > Database > Connection string > URI
# Şifre alanındaki [YOUR-PASSWORD] yerine proje veritabanı şifrenizi yazın.
# Uygulama çalışırken kullanılmaz; sadece `npm run db:setup` okur.
SUPABASE_DB_URL=postgresql://postgres.xxxxxxxxxxxx:SIFRE@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# -----------------------------------------------------------------------------
# Google Genkit (AI cins tahmini / açıklama iyileştirme) — opsiyonel
# -----------------------------------------------------------------------------
GEMINI_API_KEY=

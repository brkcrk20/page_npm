rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================
    // HELPER FUNCTIONS
    // =====================================================

    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Admin: Custom claim 'admin' true olan users
     */
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    // =====================================================
    // USERS COLLECTION - TOP LEVEL
    // =====================================================
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);

      // =====================================================
      // PET LISTINGS SUBCOLLECTION
      // =====================================================
      match /petListings/{listingId} {
        allow read: if isSignedIn();
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        allow update: if (isOwner(userId) || isAdmin()) && resource.data.userId == request.resource.data.userId;
        allow delete: if isOwner(userId) || isAdmin();
      }

      // =====================================================
      // SERVICES SUBCOLLECTION
      // =====================================================
      match /services/{serviceId} {
        allow read: if isSignedIn();
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        allow update: if (isOwner(userId) || isAdmin()) && resource.data.userId == request.resource.data.userId;
        allow delete: if isOwner(userId) || isAdmin();
      }
    }
  }
}
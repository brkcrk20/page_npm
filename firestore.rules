rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================
    // YARDIMCI FONKSİYONLAR
    // =====================================================

    function isSignedIn() {
      return request.auth != null;
    }

    // Admin: custom claim 'admin' == true
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    function incoming() {
      return request.resource.data;
    }

    // Bir güncellemede DEĞİŞEN alan kümesi
    function changedKeys() {
      return incoming().diff(resource.data).affectedKeys();
    }

    // Sadece admin'in dokunabileceği alanlar.
    // Kullanıcı kendine vitrin/doping veremesin, ilan numarasını değiştiremesin,
    // ilanını kendi onaylayamasın diye burada kilitleniyorlar.
    function adminOnlyListingFields() {
      return [
        'ilan_no',
        'kullanici_id',
        'olusturma_tarihi',
        'onayDurumu',
        'goruntulenme',
        'vitrinMi',
        'vitrinBitis',
        'doping',
        'dopingBitis',
        'oneCikar',
        'acilMi',
        'anaSayfaVitrin',
        'kategoriVitrin'
      ];
    }

    // Ücretli/öne çıkarma alanları ilan OLUŞTURURKEN hiç gönderilemez.
    // Bunlar yalnızca ödeme onayından sonra admin (ya da ileride Cloud Function)
    // tarafından yazılır.
    function hasNoPromoFieldsOnCreate() {
      return !incoming().keys().hasAny([
        'vitrinMi', 'vitrinBitis', 'doping', 'dopingBitis',
        'oneCikar', 'acilMi', 'anaSayfaVitrin', 'kategoriVitrin'
      ]);
    }

    // =====================================================
    // KULLANICILAR
    // =====================================================
    // İki ayrı kullanıcı koleksiyonu var ('users' ve 'kullanicilar');
    // RegisterForm ikisine birden yazıyor. Tek kaynağa indirilmeli — o zamana
    // kadar ikisi de aynı kurallarla korunuyor.

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      // Üyelik/abonelik durumu kullanıcı tarafından değiştirilemez.
      allow update: if isAdmin() ||
                    (isExistingOwner(userId) &&
                     !changedKeys().hasAny(['rol', 'uyelik', 'uyelikBitis', 'ilanKotasi', 'bakiye', 'isVerified']));
      allow delete: if isExistingOwner(userId) || isAdmin();

      // --- Eski yapıdan kalan alt koleksiyonlar ---
      // Yeni ilanlar kök seviyedeki /ilanlar koleksiyonuna yazılıyor.
      // Bunlar taşıma tamamlanana kadar duruyor.
      match /petListings/{listingId} {
        allow read: if isSignedIn();
        allow create: if isOwner(userId) && incoming().userId == userId;
        allow update: if (isOwner(userId) || isAdmin()) && resource.data.userId == incoming().userId;
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /services/{serviceId} {
        allow read: if isSignedIn();
        allow create: if isOwner(userId) && incoming().userId == userId;
        allow update: if (isOwner(userId) || isAdmin()) && resource.data.userId == incoming().userId;
        allow delete: if isOwner(userId) || isAdmin();
      }

      // Kullanıcının favorileri — sadece kendisi görür/yazar.
      match /favoriler/{favId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /kullanicilar/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isAdmin() ||
                    (isExistingOwner(userId) && !changedKeys().hasAny(['rol', 'durum']));
      allow delete: if isAdmin();
    }

    // =====================================================
    // İLANLAR  (kök koleksiyon — sitenin ana içeriği)
    // =====================================================
    // Doküman ID'si = ilan_no. Böylece /<baslik-slug>-<ilan_no> URL'i tek bir
    // get() ile çözülüyor, index'e ihtiyaç kalmıyor.

    match /ilanlar/{ilanId} {

      // Tekil okuma: onaylı ilanı herkes görebilir; kendi ilanını sahibi,
      // hepsini admin görebilir.
      allow get: if resource.data.onayDurumu == 'onaylandi'
                 || isOwner(resource.data.kullanici_id)
                 || isAdmin();

      // Listeleme: sorgu 'onayDurumu == onaylandi' filtresini İÇERMEK ZORUNDA.
      // (Firestore, list kuralını sorgunun kendisine karşı doğrular; bu yüzden
      //  filtresiz bir liste sorgusu reddedilir.) Kendi ilanlarını listelemek
      //  isteyen sahip 'kullanici_id == uid' filtresini kullanmalı.
      allow list: if resource.data.onayDurumu == 'onaylandi'
                  || isOwner(resource.data.kullanici_id)
                  || isAdmin();

      allow create: if isSignedIn()
                    && incoming().kullanici_id == request.auth.uid
                    && incoming().ilan_no is int
                    && incoming().baslik is string
                    && incoming().baslik.size() > 0
                    && incoming().onayDurumu in ['beklemede', 'onaylandi']
                    && hasNoPromoFieldsOnCreate();

      // Sahibi ilanını düzenleyebilir ama onay/vitrin/doping alanlarına dokunamaz.
      allow update: if isAdmin()
                    || (isOwner(resource.data.kullanici_id)
                        && !changedKeys().hasAny(adminOnlyListingFields()));

      allow delete: if isOwner(resource.data.kullanici_id) || isAdmin();

      // NOT: Görüntülenme sayacı (goruntulenme) bilerek kilitli. İstemciden
      // artırmaya izin vermek kötüye kullanıma açık; bu bir Cloud Function ya da
      // ayrı bir /ilan_sayaclari koleksiyonu ile çözülmeli.
    }

    // =====================================================
    // CİNSLER  (admin panelinden yönetilen cins kataloğu)
    // =====================================================
    match /cinsler/{cinsId} {
      allow read: if true;          // SEO için herkese açık
      allow write: if isAdmin();
    }

    // =====================================================
    // AYARLAR  (ilan numarası sayacı vb.)
    // =====================================================
    match /ayarlar/{ayarId} {
      allow read: if isSignedIn();

      // İlan sayacı: giriş yapmış kullanıcı yalnızca son_numara'yı ve yalnızca
      // bir artırabilir. Başka alan değiştiremez, geri alamaz.
      allow update: if isAdmin()
                    || (isSignedIn()
                        && ayarId == 'ilan_sayaci'
                        && changedKeys().hasOnly(['son_numara'])
                        && incoming().son_numara == resource.data.son_numara + 1);

      allow create, delete: if isAdmin();
    }

    // =====================================================
    // ÜCRETLENDİRME ALTYAPISI
    // =====================================================
    // Şu an ücretlendirme KAPALI (bkz. src/lib/monetization.ts). Koleksiyonlar
    // ve kurallar hazır bekliyor; açıldığında kural değişikliği gerekmeyecek.

    // Ürün kataloğu: doping paketleri, kurumsal abonelik planları, ilan kotaları.
    match /urunler/{urunId} {
      allow read: if true;          // fiyat listesi herkese açık
      allow write: if isAdmin();
    }

    // Siparişler. Kullanıcı sipariş OLUŞTURABİLİR ama ödendi işaretleyemez —
    // ödeme onayı yalnızca admin/Cloud Function tarafından yazılır.
    match /siparisler/{siparisId} {
      allow get, list: if isOwner(resource.data.kullanici_id) || isAdmin();

      allow create: if isSignedIn()
                    && incoming().kullanici_id == request.auth.uid
                    && incoming().durum == 'odeme_bekleniyor';

      // Kullanıcı yalnızca kendi bekleyen siparişini iptal edebilir.
      allow update: if isAdmin()
                    || (isOwner(resource.data.kullanici_id)
                        && resource.data.durum == 'odeme_bekleniyor'
                        && changedKeys().hasOnly(['durum'])
                        && incoming().durum == 'iptal');

      allow delete: if isAdmin();
    }

    // Ödeme sağlayıcısından gelen kayıtlar — istemci asla yazamaz.
    match /odemeler/{odemeId} {
      allow read: if isOwner(resource.data.kullanici_id) || isAdmin();
      allow write: if isAdmin();
    }
  }
}
